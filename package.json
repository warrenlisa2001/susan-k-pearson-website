{
  "name": "webapp",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=elemental-healing-db --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name elemental-healing",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "db:create": "wrangler d1 create elemental-healing-db",
    "db:migrate:local": "wrangler d1 migrations apply elemental-healing-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply elemental-healing-db",
    "db:query:local": "wrangler d1 execute elemental-healing-db --local --command",
    "db:query:prod": "wrangler d1 execute elemental-healing-db --command",
    "db:list-submissions": "wrangler d1 execute elemental-healing-db --command='SELECT id, full_name, email, created_at FROM intake_forms ORDER BY created_at DESC LIMIT 20'",
    "git:init": "git init && git add . && git commit -m 'Initial commit'",
    "git:commit": "git add . && git commit -m",
    "git:status": "git status",
    "git:log": "git log --oneline"
  },
  "dependencies": {
    "hono": "^4.11.4"
  },
  "devDependencies": {
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@cloudflare/workers-types": "^4.20241218.0",
    "vite": "^5.4.11",
    "wrangler": "^3.78.0",
    "typescript": "^5.0.0"
  }
}