{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "susan-k-pearson-website",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-01-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "susankpearson.com/*",
      "zone_id": "41924a4246f78faedf6a290c674de63e"
    },
    {
      "pattern": "www.susankpearson.com/*",
      "zone_id": "41924a4246f78faedf6a290c674de63e"
    }
  ]
}
